DATABASE_URL="postgresql://postgres:password@host:6543/postgres"
TELEGRAM_BOT_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Session signing secret for the v2 HTTP API (cmd/http), the same secret
# better-auth signs its session cookies with (the api/ service).
AUTH_SECRET=

# MCP server (cmd/mcp). Origin of the Expenny API — handed to MCP clients in the
# WWW-Authenticate challenge as the resource_metadata URL, so it must be absolute.
# Defaults to http://localhost:8080 when unset.
EXPENNY_API_URL=http://localhost:8080

# Decision API (internal/systemone) used to classify statement rows. The key is
# a bearer token; base URL and model are optional and fall back to the public
# gateway defaults (https://api.typesafe.ai, jev-1.13.0).
CLASSIFIER_API_KEY=
CLASSIFIER_BASE_URL=
CLASSIFIER_MODEL=
