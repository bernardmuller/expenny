DATABASE_URL=
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

AUTH_SECRET=
AUTH_URL=http://localhost:3000
RESEND_KEY=
JWT_SECRET=your-super-secret-key-here
MAIL_ADDRESS="your@domain.com"
CRON_SECRET=

# Auth mode: "legacy" | "better-auth" (feature flag)
AUTH_MODE=legacy
# Optional: defaults to AUTH_SECRET / api origin when unset
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
# Google OAuth (only used when AUTH_MODE=better-auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
