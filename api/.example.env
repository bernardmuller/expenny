DATABASE_URL=
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

AUTH_SECRET=
AUTH_URL=http://localhost:3000
RESEND_KEY=
MAIL_ADDRESS="your@domain.com"
ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
CRON_SECRET=

# Better Auth — required for session signing and OIDC/MCP flows
BETTER_AUTH_SECRET=
# Origin the browser uses to reach the API. Also the OIDC issuer advertised in the
# /.well-known discovery documents that the MCP server consumes.
BETTER_AUTH_URL=http://localhost:8080
# Google OAuth (optional — hides the Google button if absent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where Google sends the browser back to. Must be registered verbatim in the Google
# Console. Defaults to ${AUTH_URL}/auth/callback/google so the roundtrip stays on the
# web origin, which proxies /auth to this API. Set explicitly to point it at the API
# origin instead (e.g. when the web host has no /auth proxy rule).
# GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback/google

# Public URL of the MCP resource server (the Go MCP binary, cmd/mcp — see PORT
# there, default 5420). This becomes the `resource` field of the
# protected-resource metadata, and MCP clients reject metadata whose `resource`
# does not match the server they are connecting to (RFC 9728), so it must be the
# exact URL clients use — not the API's origin.
# Default: ${BETTER_AUTH_URL}/mcp
MCP_RESOURCE_URL=http://localhost:5420/mcp
